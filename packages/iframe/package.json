{
  "name": "@flittpayments/checkout-iframe",
  "version": "1.0.0",
  "description": "Iframe wrapper for Flitt Checkout",
  "repository": {
    "type": "git",
    "url": "https://github.com/flittpayments/checkout-vue.git",
    "directory": "packages/checkout-iframe"
  },
  "license": "MIT",
  "author": "Mykhailo Holubovskyi <lamerumiata@gmail.com>",
  "type": "module",
  "exports": {
    "import": "./dist/index.mjs",
    "require": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "certs:gen": "sh ./scripts/generate-certs.sh",
    "dev": "rollup -c -w --environment IFRAME_URL:https://localhost:3001/index.html",
    "pre-commit": "lint-staged",
    "prettier:fix": "prettier . --write",
    "serve:ssl": "serve dist --cors --ssl-cert ./certs/cert.pem --ssl-key ./certs/key.pem"
  },
  "lint-staged": {
    "package.json": "sort-package-json",
    "*.{js,mjs,json,md,html}": "prettier --write"
  },
  "prettier": {
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "lint-staged": "^16.4.0",
    "minimist": "^1.2.8",
    "prettier": "^3.9.6",
    "rollup": "^4.62.2",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "serve": "^14.2.6",
    "sort-package-json": "^3.7.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
