{
  "name": "@flittpayments/checkout",
  "version": "1.17.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/flittpayments/checkout-vue.git",
    "directory": "packages/checkout"
  },
  "license": "MIT",
  "author": "Mykhailo Holubovskyi <lamerumiata@gmail.com>",
  "exports": {
    "import": "./dist/checkout.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:localhost": "node scripts/build.mjs --public-path=http://localhost:3000/ --saas_template_name=flitt --saas_cdn_url=https://sandbox.pay.flitt.dev/icons/dist/ --api_domain=sandbox.pay.flitt.dev --sentry_dsn= --environment=development",
    "dev": "node scripts/dev.mjs --public-path=https://checkout/ --saas_template_name=flitt --saas_cdn_url=https://sandbox.pay.flitt.dev/icons/dist/ --api_domain=sandbox.pay.flitt.dev --sentry_dsn= --environment=development",
    "eslint:fix": "eslint . --fix",
    "pre-commit": "lint-staged",
    "prettier:fix": "prettier . --write",
    "serve": "serve -s dist --cors",
    "stylelint:fix": "stylelint \"src/**/*.{scss,vue}\" --fix"
  },
  "lint-staged": {
    "package.json": "sort-package-json",
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{scss,vue}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "browserslist": [
    "Chrome >= 49",
    "Firefox >= 52",
    "Edge >= 79",
    "Safari >= 10",
    "iOS >= 10",
    "Android >= 5",
    "not IE 11",
    "not dead"
  ],
  "prettier": {
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard-scss",
      "stylelint-config-recommended-vue/scss",
      "stylelint-config-prettier-scss"
    ],
    "rules": {
      "scss/no-global-function-names": null,
      "scss/dollar-variable-pattern": "^[a-z][a-z0-9_-]*$",
      "selector-class-pattern": "^[a-z][a-z0-9_-]*$",
      "custom-property-pattern": "^_?[a-z][a-z0-9-]*$",
      "declaration-block-no-redundant-longhand-properties": null
    }
  },
  "dependencies": {
    "@flittpayments/js-sdk": "^2.0.15",
    "@popperjs/core": "^2.11.8",
    "@sentry/vue": "^8.55.2",
    "@vee-validate/i18n": "^4.15.1",
    "@vee-validate/rules": "^4.15.1",
    "async-validator": "^3.5.2",
    "axios": "^1.20.0",
    "core-js": "^3.50.0",
    "css-vars-ponyfill": "^2.4.9",
    "date-format-parse": "^0.2.7",
    "ismobilejs": "^1.1.1",
    "mitt": "^3.0.1",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "world-countries": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "@vue/compiler-sfc": "^3.5.44",
    "circular-dependency-plugin": "^5.2.2",
    "es-check": "^9.8.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "gulp": "^5.0.1",
    "lint-staged": "^17.6.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "sass-loader": "^17.0.1",
    "serve": "^14.2.6",
    "sort-package-json": "^4.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-webpack-plugin": "^5.1.0",
    "vue-svg-loader": "^0.17.0-beta.2",
    "webpack-assets-manifest": "^6.5.4",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-subresource-integrity": "^5.2.0-rc.1",
    "xgettext-utils": "^0.0.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  }
}
