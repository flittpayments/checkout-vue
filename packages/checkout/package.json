{
  "name": "@flittpayments/checkout",
  "version": "1.16.11",
  "repository": {
    "type": "git",
    "url": "https://github.com/flittpayments/checkout-vue.git",
    "directory": "packages/checkout"
  },
  "license": "MIT",
  "author": "Mykhailo Holubovskyi <lamerumiata@gmail.com>",
  "exports": {
    "import": "./dist/checkout.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run gulp && vue-cli-service build --no-module",
    "build:localhost": "npm run gulp && vue-cli-service build --no-module --public-path=http://localhost:3000/ --saas_template_name=flitt --saas_cdn_url=https://sandbox.pay.flitt.dev/icons/dist/ --api_domain=sandbox.pay.flitt.dev --sentry_dsn= --environment=development",
    "dev": "vue-cli-service serve --public-path=https://checkout/ --saas_template_name=flitt --saas_cdn_url=https://sandbox.pay.flitt.dev/icons/dist/ --api_domain=sandbox.pay.flitt.dev --sentry_dsn= --environment=development",
    "eslint:fix": "eslint src/**/*.{js,vue} --fix",
    "gulp": "gulp",
    "lint": "vue-cli-service lint",
    "pre-commit": "lint-staged",
    "prettier:fix": "prettier src/**/*.{js,vue,scss} --write",
    "serve": "serve -s dist --cors",
    "stylelint:fix": "stylelint src/{**/,**/**/}*.scss --custom-syntax postcss-scss --color --formatter verbose --fix"
  },
  "lint-staged": {
    "package.json": "sort-package-json",
    "*.{js,vue}": [
      "vue-cli-service lint --fix",
      "prettier --write"
    ],
    "src/**/*.scss": [
      "stylelint --custom-syntax postcss-scss --fix",
      "prettier --write"
    ]
  },
  "browserslist": [
    "defaults",
    "Chrome >= 45",
    "Firefox >= 38",
    "Edge >= 12",
    "Explorer >= 11",
    "iOS >= 9",
    "Safari >= 9",
    "Android >= 4.4",
    "Opera >= 30"
  ],
  "prettier": {
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "eslintConfig": {
    "env": {
      "node": true
    },
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "extends": [
      "plugin:vue/recommended",
      "eslint:recommended",
      "plugin:prettier/recommended"
    ],
    "rules": {
      "no-console": 0,
      "no-useless-escape": 0,
      "no-var": 2,
      "vue/html-self-closing": [
        "warn",
        {
          "html": {
            "void": "always",
            "normal": "always",
            "component": "always"
          },
          "svg": "always",
          "math": "always"
        }
      ],
      "vue/multi-word-component-names": 0,
      "vue/no-v-html": 0
    },
    "globals": {
      "API_DOMAIN": "readonly",
      "COMMITHASH": "readonly",
      "DOMAIN": "readonly",
      "ENVIRONMENT": "readonly",
      "INITIATOR": "readonly",
      "PUBLIC_PATH": "readonly",
      "SAAS_CDN_URL": "readonly",
      "SAAS_TEMPLATE_NAME": "readonly",
      "SENTRY_DSN": "readonly",
      "VERSION": "readonly",
      "X_PAYMENT_GATEWAY": "readonly"
    },
    "root": true
  },
  "stylelint": {
    "syntax": "scss",
    "extends": [
      "stylelint-config-standard-scss",
      "stylelint-config-prettier-scss"
    ],
    "rules": {
      "scss/double-slash-comment-whitespace-inside": null,
      "scss/no-global-function-names": null,
      "scss/at-if-no-null": null,
      "scss/at-extend-no-missing-placeholder": null,
      "scss/comment-no-empty": null,
      "scss/at-mixin-pattern": null,
      "no-descending-specificity": null,
      "media-feature-name-no-unknown": null,
      "scss/dollar-variable-default": null,
      "scss/dollar-variable-pattern": "^[a-z][a-z-\\d_]*$",
      "selector-class-pattern": "^[a-z][a-z0-9\\-_]*[a-z0-9]$",
      "declaration-block-no-redundant-longhand-properties": null
    }
  },
  "dependencies": {
    "@flittpayments/js-sdk": "^2.0.11-alpha.0",
    "@sentry/vue": "^8.55.2",
    "async-validator": "^3.5.2",
    "axios": "^1.18.1",
    "core-js": "^3.49.0",
    "css-vars-ponyfill": "^2.4.9",
    "date-format-parse": "^0.2.7",
    "ismobilejs": "^1.1.1",
    "popper.js": "^1.16.1",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.1",
    "vee-validate": "^3.4.15",
    "vue": "^2.7.16",
    "vue-functional-data-merge": "^3.1.0",
    "vue-i18n": "^8.28.2",
    "vue-router": "^3.6.5",
    "vue2-datepicker": "~3.8.2",
    "world-countries": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-plugin-eslint": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "circular-dependency-plugin": "^5.2.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-vue": "^9.33.0",
    "git-revision-webpack-plugin": "^5.0.0",
    "gulp": "^5.0.1",
    "lint-staged": "^16.4.0",
    "minimist": "^1.2.8",
    "prettier": "^3.9.6",
    "sass": "~1.79.6",
    "sass-loader": "^16.0.8",
    "serve": "^14.2.6",
    "sort-package-json": "^3.7.1",
    "stylelint": "^16.26.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-webpack-plugin": "^5.1.0",
    "vue-svg-loader": "^0.17.0-beta.2",
    "vue-template-compiler": "^2.7.16",
    "webpack-assets-manifest": "^6.5.2",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-subresource-integrity": "^5.2.0-rc.1",
    "xgettext-utils": "^0.0.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  }
}
