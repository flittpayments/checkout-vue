{
  "name": "@flittpayments/checkout",
  "version": "1.17.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/flittpayments/checkout-vue.git",
    "directory": "packages/checkout"
  },
  "license": "MIT",
  "author": "Mykhailo Holubovskyi <lamerumiata@gmail.com>",
  "exports": {
    "import": "./dist/checkout.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:localhost": "node scripts/build.js --public-path=http://localhost:3000/ --saas_template_name=flitt --saas_cdn_url=https://sandbox.pay.flitt.dev/icons/dist/ --api_domain=sandbox.pay.flitt.dev --sentry_dsn= --environment=development",
    "dev": "node scripts/dev.js --public-path=https://checkout/ --saas_template_name=flitt --saas_cdn_url=https://sandbox.pay.flitt.dev/icons/dist/ --api_domain=sandbox.pay.flitt.dev --sentry_dsn= --environment=development",
    "eslint:fix": "eslint src/**/*.{js,vue} --fix",
    "pre-commit": "lint-staged",
    "prettier:fix": "prettier . --write",
    "serve": "serve -s dist --cors",
    "stylelint:fix": "stylelint src/**/*.scss --fix"
  },
  "lint-staged": {
    "package.json": "sort-package-json",
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "browserslist": [
    "Chrome >= 49",
    "Firefox >= 52",
    "Edge >= 79",
    "Safari >= 10",
    "iOS >= 10",
    "Android >= 5",
    "not IE 11",
    "not dead"
  ],
  "prettier": {
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "stylelint": {
    "customSyntax": "postcss-scss",
    "extends": [
      "stylelint-config-standard-scss"
    ],
    "rules": {
      "scss/double-slash-comment-whitespace-inside": null,
      "scss/no-global-function-names": null,
      "scss/at-if-no-null": null,
      "scss/at-extend-no-missing-placeholder": null,
      "scss/comment-no-empty": null,
      "scss/at-mixin-pattern": null,
      "no-descending-specificity": null,
      "media-feature-name-no-unknown": null,
      "scss/dollar-variable-default": null,
      "scss/dollar-variable-pattern": "^[a-z][a-z-\\d_]*$",
      "selector-class-pattern": "^[a-z][a-z0-9\\-_]*[a-z0-9]$",
      "declaration-block-no-redundant-longhand-properties": null
    }
  },
  "dependencies": {
    "@flittpayments/js-sdk": "^2.0.11",
    "@popperjs/core": "^2.11.8",
    "@sentry/vue": "^8.55.2",
    "@vee-validate/i18n": "^4.15.1",
    "@vee-validate/rules": "^4.15.1",
    "async-validator": "^3.5.2",
    "axios": "^1.20.0",
    "core-js": "^3.50.0",
    "css-vars-ponyfill": "^2.4.9",
    "date-format-parse": "^0.2.7",
    "ismobilejs": "^1.1.1",
    "mitt": "^3.0.1",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.2",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0",
    "world-countries": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-sfc": "^3.5.43",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "gulp": "^5.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "serve": "^14.2.6",
    "sort-package-json": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.14.5",
    "vite-svg-loader": "^5.1.3",
    "xgettext-utils": "^0.0.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  }
}
